{
  "expo": {
    "name": "Carpuling",
    "slug": "carpuling",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo/1024x1024.jpg",
    "splash": {
      "image": "./assets/logo/1284x1284.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/4f43e00d-f804-4c94-aa0a-beae6f6be58a",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.0",
    "notification": {
      "icon": "./assets/logo/192x192.jpg",
      "color": "#000000",
      "sounds": [
        "default"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carpuling.app.ar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte en el mapa y calcular rutas.",
        "NSLocationAlwaysUsageDescription": "Necesitamos tu ubicación para mostrarte en el mapa y calcular rutas.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "carpooling"
            ]
          }
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCZrthjojUC8UfaaUaO7_3w_RmJMoALrz8"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "adjustResize",
      "package": "com.carpuling.app.ar",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "carpooling",
              "host": "payments",
              "pathPrefix": "/confirmation"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCZrthjojUC8UfaaUaO7_3w_RmJMoALrz8"
        }
      }
    },
    "plugins": [
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/192x192.jpg",
          "color": "#000000",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Carpuling"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación para mostrarte en el mapa y calcular rutas."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "carpooling",
    "extra": {
      "eas": {
        "projectId": "4f43e00d-f804-4c94-aa0a-beae6f6be58a"
