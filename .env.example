# Configuración de la API (iOS/Android nativo y builds de producción web de Expo)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:5000/api

# Solo Metro Web en desarrollo: por defecto la app usa localhost:5000/api.
# Descomentá si necesitás otro host (p. ej. backend en otra máquina):
# EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:5000/api

# Para Android Emulator: http://10.0.2.2:5000/api
# Para iOS Simulator: http://localhost:5000/api

# Pagos: Uala Bis se configura en backend/.env (UALA_BIS_USERNAME, UALA_BIS_CLIENT_ID, UALA_BIS_CLIENT_SECRET_ID)
